# ========================================
# Archivos comunes que deben ignorarse
# ========================================

# Dependencias (se instalan en el contenedor)
node_modules
__pycache__
*.pyc
*.pyo
*.pyd
env
venv

# Archivos del sistema
.DS_Store
.vscode
.idea

# Archivos de log y temporales
*.log
*.swp
*.swo

# Git y control de versiones
.git
.gitignore

# ========================================
# Next.js
# ========================================
.next
out
dist

# .env
# .env.*
# !.env.prod

# ========================================
# Django / DRF
# ========================================

# Base de datos SQLite (local)
db.sqlite3
*.sqlite3

# Migrations (opcional si no quieres copiarlas al contenedor)
**/migrations/
!**/migrations/__init__.py

# Archivos estáticos y media (opcional si se sirven externamente)
staticfiles/
media/

# ========================================
# Otros
# ========================================
npm-debug.log
yarn-error.log
coverage/
htmlcov/
